{
  "name": "speed-test-v1",
  "version": "1.0.0",
  "description": "Test de connexion Windows avec confidentialité de l'adresse IP",
  "author": "XT.07",
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --win nsis --x64",
    "dist:cross": "electron-builder --win --x64 --dir -c.win.signAndEditExecutable=false && node scripts/build-installer.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "pe-library": "2.0.1",
    "resedit": "3.1.0"
  },
  "build": {
    "appId": "fr.xt07.speedtest",
    "productName": "Speed Test V1",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Speed Test V1",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/sidebar.bmp",
      "uninstallerSidebar": "build/sidebar.bmp",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "fr_FR"
      ],
      "artifactName": "Speed-Test-V1-Setup-${version}.exe"
    },
    "afterPack": "scripts/brand-exe.cjs"
  }
}
